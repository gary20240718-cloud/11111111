RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")

    -- 隱形 (含武器)
    if invisEnabled and char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.LocalTransparencyModifier = 0 
                part.Transparency = 1 
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = 1
            end
        end
        for _, acc in pairs(char:GetChildren()) do
            if acc:IsA("Accessory") and acc:FindFirstChild("Handle") then
                acc.Handle.Transparency = 1
            end
        end
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            for _, tool in pairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    for _, part in pairs(tool:GetDescendants()) do
                        if part:IsA("BasePart") then part.Transparency = 1 end
                    end
                end
            end
        end
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                for _, part in pairs(tool:GetDescendants()) do
                    if part:IsA("BasePart") then part.Transparency = 1 end
                end
            end
        end
    end

    -- 防掉圖與無敵
    if humanoid then
        if godEnabled or flyEnabled then
            if humanoid.Health < humanoid.MaxHealth then
                humanoid.Health = humanoid.MaxHealth
            end
            if hrp and hrp.Position.Y < -50 then
                hrp.CFrame = CFrame.new(hrp.Position.X, 50, hrp.Position.Z)
            end
        end
    end

    -- 飛天控制
    if flyEnabled and hrp and humanoid then
        local bv = hrp:FindFirstChild("HackFly")
        if bv then
            local moveDir = humanoid.MoveDirection * 60
            if isGoingUp then moveDir = moveDir + Vector3.new(0, 50, 0) end
            if isGoingDown then moveDir = moveDir - Vector3.new(0, 80, 0) end

            if humanoid.MoveDirection.Magnitude == 0 and not isGoingUp and not isGoingDown then
                bv.Velocity = Vector3.new(0, 2, 0)
            else
                bv.Velocity = moveDir
            end
        end
    end

    -- 透視與敵人收集
    local activePlayers = {}
    local enemies = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local pChar = player.Character
            local pHumanoid = pChar:FindFirstChildOfClass("Humanoid")
            local pHead = pChar:FindFirstChild("Head")
            local pRoot = pChar:FindFirstChild("HumanoidRootPart")
            
            if pHumanoid and pHumanoid.Health > 0 and pHead and pRoot then
                activePlayers[player.UserId] = true
                local dist = math.floor((Camera.CFrame.Position - pRoot.Position).Magnitude)

                if dist <= 350 then
                    table.insert(enemies, pRoot)

                    if espEnabled then
                        local health = math.floor(pHumanoid.Health)
                        local headPos, onScreen = Camera:WorldToViewportPoint(pHead.Position + Vector3.new(0, 0.5, 0))

