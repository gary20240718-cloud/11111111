-- 底層攔截：視覺自瞄 (開槍時槍口對準，不影響鏡頭)
pcall(function()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if aimbotEnabled and (method == "Raycast" or method == "FindPartOnRay") then
            local closestTarget = nil
            local shortestDist = math.huge

            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and not p:IsTeammate(LocalPlayer) then
                    local head = p.Character:FindFirstChild("Head")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if head and hum and hum.Health > 0 then
                        -- 檢查敵人的頭部是否在螢幕上，並且沒有被牆擋住（視覺可見）
                        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen and screenPos.Z > 0 then
                            -- Raycast 檢查視線
                            local rayParams = RaycastParams.new()
                            rayParams.FilterDescendantsInstances = {LocalPlayer.Character, p.Character}
                            rayParams.FilterType = Enum.RaycastFilterType.Exclude
                            local rayDir = (head.Position - Camera.CFrame.Position).Unit * 1000
                            local rayHit = workspace:Raycast(Camera.CFrame.Position, rayDir, rayParams)
                            
                            -- 如果射線沒有打到東西，代表看得到他
                            if not rayHit then
                                local dist = (Camera.CFrame.Position - head.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    closestTarget = head
                                end
                            end
                        end
                    end
                end
            end

            -- 將子彈終點改為目標頭部
            if closestTarget then
                if method == "Raycast" then
                    local origin = args[1]
                    local direction = args[2]
                    args[2] = (closestTarget.Position - origin).Unit * direction.Magnitude
                end
            end
        end
        return oldNamecall(self, unpack(args))
    end)
    setreadonly(mt, true)
end)

-- ==========================================
-- 3. 即時運算迴圈 (旋轉、透視、瞬移)
-- ==========================================
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")

    -- 旋轉 (不影響相機與子彈)
    if spinEnabled and hrp then
        -- 旋轉角色，但紀錄原本的面向，避免子彈打歪
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(20), 0)
    end

    -- 飛天控制
    if flyEnabled and hrp and humanoid then
        local bv = hrp:FindFirstChild("HackFly")
        if bv then
            local moveDir = humanoid.MoveDirection * 60
            if isGoingUp then moveDir = moveDir + Vector3.new(0, 50, 0) end
            if isGoingDown then moveDir = moveDir - Vector3.new(0, 80, 0) end
            if humanoid.MoveDirection.Magnitude == 0 and not isGoingUp and not isGoingDown then
                bv.Velocity = Vector3.new(0, 2, 0)
            else
                bv.Velocity = moveDir
            end
        end
    end

    -- 透視收集與繪製
    local activePlayers = {}
    local enemies = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not player:IsTeammate(LocalPlayer) then
            local pChar = player.Character
            local pHumanoid = pChar:FindFirstChildOfClass("Humanoid")
            local pHead = pChar:FindFirstChild("Head")
            local pRoot = pChar:FindFirstChild("HumanoidRootPart")
            
            if pHumanoid and pHumanoid.Health > 0 and pHead and pRoot then
                activePlayers[player.UserId] = true
                local dist = math.floor((Camera.CFrame.Position - pRoot.Position).Magnitude)

                if dist <= 350 then
                    table.insert(enemies, pRoot)
                    
                    if espEnabled then
                        local health = math.floor(pHumanoid.Health)
                        local maxHealth = math.floor(pHumanoid.MaxHealth)
                        local headPos, onScreen = Camera:WorldToViewportPoint(pHead.Position + Vector3.new(0, 0.5, 0))
                        local rootPos = Camera:WorldToViewportPoint(pRoot.Position - Vector3.new(0, 2.5, 0))

                        if onScreen then
                            local boxName = "ESP_Box_" .. player.UserId
                            local box = ScreenGui:FindFirstChild(boxName)
                            if not box then
                                box = Instance.new("Frame")
                                box.Name = boxName
                                box.BackgroundTransparency = 1
                                box.BorderSizePixel = 1
                                box.BorderColor3 = Color3.fromRGB(255, 0, 0)
                                box.Parent = ScreenGui
                            end
                            
                            -- 繪製全身框
                            local height = math.abs(headPos.Y - rootPos.Y)
                            local width = height / 2
                            if height < 30 then height = 30 end
                            if width < 15 then width = 15 end
                            
                            box.Visible = true
                            box.Size = UDim2.new(0, width, 0, height) 
                            box.Position = UDim2.new(0, headPos.X - (width/2), 0, headPos.Y)

                            -- 繪製文字
                            local tagName = "ESP_Tag_" .. player.UserId
                            local textTag = ScreenGui:FindFirstChild(tagName)
                            if not textTag then
                                textTag = Instance.new("TextLabel")
                                textTag.Name = tagName
                                textTag.BackgroundTransparency = 1
                                textTag.TextColor3 = Color3.fromRGB(255, 255, 255)
                                textTag.TextStrokeTransparency = 0
                                textTag.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                                textTag.Font = Enum.Font.SourceSansBold
                                textTag.TextSize = 14
                                textTag.Parent = ScreenGui
                            end
                            
                            textTag.Visible = true
                            -- 增強文字可見度
                            textTag.Text = player.Name .. "\nHP: " .. health .. "/" .. maxHealth .. "\n[" .. dist .. "m]"
                            textTag.Position = UDim2.new(0, headPos.X - 60, 0, headPos.Y - 45)
                            
                            -- 繪製血條
                            local barName = "ESP_Bar_" .. player.UserId
                            local bar = ScreenGui:FindFirstChild(barName)
                            if not bar then
                                bar = Instance.new("Frame")
                                bar.Name = barName
                                bar.BorderSizePixel = 0
                                bar.Parent = ScreenGui
                                local barFill = Instance.new("Frame")
                                barFill.Name = "Fill"
                                barFill.Size = UDim2.new(1, 0, 1, 0)
                                barFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                                barFill.Parent = bar
                            end
                            bar.Visible = true
                            bar.Size = UDim2.new(0, 40, 0, 5)
                            bar.Position = UDim2.new(0, headPos.X - 20, 0, headPos.Y - 10)
                            bar.Fill.Size = UDim2.new(health/maxHealth, 0, 1, 0)
                            if health/maxHealth > 0.5 then bar.Fill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                            elseif health/maxHealth > 0.2 then bar.Fill.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
                            else bar.Fill.BackgroundColor3 = Color3.fromRGB(255, 0, 0) end
                            
                        else
                            local box = ScreenGui:FindFirstChild("ESP_Box_" .. player.UserId)
                            if box then box.Visible = false end
                            local tag = ScreenGui:FindFirstChild("ESP_Tag_" .. player.UserId)
                            if tag then tag.Visible = false end
                            local bar = ScreenGui:FindFirstChild("ESP_Bar_" .. player.UserId)
                            if bar then bar.Visible = false end
                        end
                    end
                end
            end
        end
    end

    -- 清理死人或退出的
    if espEnabled then
        for _, obj in pairs(ScreenGui:GetChildren()) do
            if obj.Name:match("ESP_") then
                local idStr = obj.Name:gsub("ESP_Box_", ""):gsub("ESP_Tag_", ""):gsub("ESP_Bar_", "")
                local id = tonumber(idStr)
                if not activePlayers[id] then obj:Destroy() end
            end
        end
    end

    -- 瞬移 (貼臉、防虛空、排除隊友)
    if followEnabled and hrp then
        -- 強制無碰撞防止卡牆
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        if #enemies > 0 then
            local closestRoot = nil
            local shortestDist = math.huge
            local myPos = hrp.Position

            for _, enemyRoot in pairs(enemies) do
                local dist = (myPos - enemyRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestRoot = enemyRoot
                end
            end

            if closestRoot then
                local targetPos = closestRoot.Position + Vector3.new(0, heightOffset, 0)
                -- 確保不會掉到地板下
                if targetPos.Y > -20 then
                    hrp.CFrame = CFrame.new(targetPos)
                end
            end
        end
    end
end)

